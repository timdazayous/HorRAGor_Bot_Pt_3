# HorRAGor BOT — UI Streamlit (Couche Présentation)
FROM python:3.10-slim

RUN pip install --no-cache-dir uv

WORKDIR /app

# Dépendances d'abord (cache Docker : ne se réinstalle que si pyproject/uv.lock changent)
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-install-project --no-dev

# app_frontend.py est un script racine autonome, pas de dépendance à src/.
COPY app_frontend.py ./

EXPOSE 8501

CMD ["uv", "run", "--no-dev", "streamlit", "run", "app_frontend.py", "--server.address=0.0.0.0", "--server.port=8501"]
