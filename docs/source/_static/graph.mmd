---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	rag(rag)
	scraper(scraper)
	narration(narration)
	judge(judge)
	__end__([<p>__end__</p>]):::last
	__start__ --> rag;
	judge -. &nbsp;end&nbsp; .-> __end__;
	judge -. &nbsp;retry&nbsp; .-> narration;
	narration --> judge;
	rag -.-> narration;
	rag -.-> scraper;
	scraper --> narration;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
